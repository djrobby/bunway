DATABASE_URL=postgres://postgres:postgres@localhost:5432/bunway_development
# Jobs run in-process without a database until DATABASE_URL is configured.
# BUNWAY_JOBS_DATABASE names an alternative jobs database; its URL variable
# is derived from the name (for example QUEUE_DATABASE_URL).
BUNWAY_ID_TYPE=uuid
PORT=3000
CORS_ORIGIN=http://localhost:5173
STORAGE_SERVICE=local
STORAGE_PATH=storage
STORAGE_PUBLIC_URL=http://localhost:3000/storage
# S3/R2: STORAGE_BUCKET, STORAGE_ACCESS_KEY_ID, STORAGE_SECRET_ACCESS_KEY,
# STORAGE_ENDPOINT, STORAGE_REGION, STORAGE_PUBLIC_URL
