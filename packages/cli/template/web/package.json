{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsgo --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "@typescript/native": "npm:typescript@latest",
    "typescript": "~6.0.0",
    "vite": "latest"
  },
  "dependencies": {
    "bits-ui": "2.19.0",
    "clsx": "2.1.1",
    "remixicon-svelte": "0.0.5",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  }
